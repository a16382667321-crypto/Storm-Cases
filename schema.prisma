generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  telegramId        String    @unique
  username          String?
  firstName         String?
  lastName          String?
  languageCode      String?
  isBot             Boolean   @default(false)
  isPremium         Boolean   @default(false)
  isAdmin           Boolean   @default(false)
  isModerator       Boolean   @default(false)
  isMuted           Boolean   @default(false)
  isBanned          Boolean   @default(false)
  muteUntil         DateTime?
  banReason         String?
  balance           Float     @default(0)
  premiumBalance    Float     @default(0)
  level             Int       @default(1)
  experience        Int       @default(0)
  reputation        Int       @default(0)
  referralCode      String?   @unique
  referredBy        String?
  referrer          User?     @relation("ReferrerRelation", fields: [referredBy], references: [id])
  referrals         User[]    @relation("ReferrerRelation")
  dailyStreak       Int       @default(0)
  lastDailyClaim    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  inventory         InventoryItem[]
  transactions      Transaction[]
  caseOpens         CaseOpen[]
  supportTickets    SupportTicket[]
  supportResponses  SupportResponse[]
  chatMessages      ChatMessage[]
  marketListings    MarketListing[] @relation("SellerItems")
  marketPurchases   MarketListing[] @relation("PurchasedItems")
  achievements      UserAchievement[]
  notifications     Notification[]
  logs              ActivityLog[]
}

model Case {
  id          String   @id @default(uuid())
  name        String
  nameRu      String?
  description String?
  descriptionRu String?
  imageUrl    String?
  rarity      Rarity   @default(COMMON)
  price       Float
  currency    Currency @default(STORM_COINS)
  isActive    Boolean  @default(true)
  isLimited   Boolean  @default(false)
  limitedUntil DateTime?
  guaranteeRarity Rarity?
  guaranteeEvery Int @default(0)
  battleMode  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  items       CaseItem[]
  opens       CaseOpen[]
}

model Item {
  id          String   @id @default(uuid())
  name        String
  nameRu      String?
  description String?
  descriptionRu String?
  imageUrl    String?
  rarity      Rarity   @default(COMMON)
  type        ItemType @default(ITEM)
  basePrice   Float
  isCraftable Boolean  @default(false)
  craftFrom   String[] // JSON array of item IDs
  craftAmount Int      @default(1)
  isUpgradeable Boolean @default(false)
  upgradeFrom String?
  upgradeTo   String?
  isCollection Boolean @default(false)
  collectionId String?
  statTrack   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  caseItems   CaseItem[]
  inventory   InventoryItem[]
  upgrades    ItemUpgrade[]
  marketListings MarketListing[]
  upgradeTargets ItemUpgrade[] @relation("UpgradeTo")
}

model CaseItem {
  id        String  @id @default(uuid())
  caseId    String
  itemId    String
  dropRate  Float   // 0-100
  isGuaranteed Boolean @default(false)
  
  case      Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  
  @@unique([caseId, itemId], name: "caseId_itemId")
}

model InventoryItem {
  id          String   @id @default(uuid())
  userId      String
  itemId      String
  quantity    Int      @default(1)
  isTradable  Boolean  @default(true)
  isFavorite  Boolean  @default(false)
  obtainedAt  DateTime @default(now())
  statTrack   Int?     // For stat-track items
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  
  @@unique([userId, itemId], name: "userId_itemId")
}

model CaseOpen {
  id          String   @id @default(uuid())
  userId      String
  caseId      String
  items       String   // JSON array of dropped item IDs
  totalValue  Float
  currency    Currency @default(STORM_COINS)
  isBattle    Boolean  @default(false)
  battleId    String?
  openedAt    DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String        @id @default(uuid())
  userId      String
  type        TransactionType
  amount      Float
  currency    Currency      @default(STORM_COINS)
  description String
  metadata    String?       // JSON
  createdAt   DateTime      @default(now())
  
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MarketListing {
  id          String   @id @default(uuid())
  sellerId    String
  itemId      String
  price       Float
  currency    Currency @default(STORM_COINS)
  isAuction   Boolean  @default(false)
  auctionEnd  DateTime?
  currentBid  Float?
  buyerId     String?
  soldAt      DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  seller      User     @relation("SellerItems", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer       User?    @relation("PurchasedItems", fields: [buyerId], references: [id])
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String
  subject     String
  message     String
  status      TicketStatus @default(OPEN)
  priority    Priority    @default(MEDIUM)
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses   SupportResponse[]
}

model SupportResponse {
  id          String   @id @default(uuid())
  ticketId    String
  userId      String
  isAdmin     Boolean  @default(false)
  message     String
  createdAt   DateTime @default(now())
  
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id          String   @id @default(uuid())
  userId      String
  username    String?
  message     String
  isSystem    Boolean  @default(false)
  replyTo     String?
  reactions   String?  // JSON array of reactions
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, achievementId])
}

model Achievement {
  id          String   @id @default(uuid())
  name        String
  nameRu      String?
  description String
  descriptionRu String?
  iconUrl     String?
  reward      Float
  xpReward    Int
  requirement String   // JSON describing requirements
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  title       String
  message     String
  type        NotificationType @default(INFO)
  isRead      Boolean  @default(false)
  actionUrl   String?
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  details     String?  // JSON
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PromoCode {
  id          String   @id @default(uuid())
  code        String   @unique
  reward      Float
  rewardType  PromoRewardType @default(BALANCE)
  maxUses     Int?
  usedCount   Int      @default(0)
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
}

model ItemUpgrade {
  id          String   @id @default(uuid())
  fromItemId  String
  toItemId    String
  successRate Float
  cost        Float
  currency    Currency @default(STORM_COINS)
  
  fromItem    Item     @relation(fields: [fromItemId], references: [id], onDelete: Cascade)
  toItem      Item     @relation("UpgradeTo", fields: [toItemId], references: [id], onDelete: Cascade)
}

model CurrencyRate {
  id          String   @id @default(uuid())
  fromCurrency Currency
  toCurrency  Currency
  rate        Float
  updatedAt   DateTime @updatedAt
  
  @@unique([fromCurrency, toCurrency], name: "fromCurrency_toCurrency")
}

model PremiumSubscription {
  id          String   @id @default(uuid())
  userId      String
  plan        PremiumPlan
  startDate   DateTime @default(now())
  endDate     DateTime
  isActive    Boolean  @default(true)
  autoRenew   Boolean  @default(false)
  
  @@unique([userId])
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHICAL
}

enum Currency {
  STORM_COINS
  PREMIUM_COINS
  REAL_MONEY
}

enum ItemType {
  ITEM
  KEY
  BOOSTER
  COLLECTION
  BADGE
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  CASE_OPEN
  ITEM_PURCHASE
  ITEM_SALE
  CRAFT
  UPGRADE
  REFERRAL
  DAILY_REWARD
  ACHIEVEMENT
  PROMO_CODE
  ADMIN_GIVE
  MARKET_FEE
  BATTLE_WIN
  BATTLE_LOSE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ACHIEVEMENT
  MARKET
  CHAT
  SYSTEM
}

enum PromoRewardType {
  BALANCE
  PREMIUM_BALANCE
  XP
  ITEM
  CASE
}

enum PremiumPlan {
  BASIC
  STANDARD
  PREMIUM
  VIP
}